# Telegram Bot API Token (Get it from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Comma-separated list of Telegram User IDs permitted to access the admin panel and post workflow
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=123456789

# Database path (optional, defaults to local SQLite file bot.db in the directory)
# DATABASE_PATH=bot.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Render / Self-Ping Keep-Alive Settings ---
# The port the keep-alive web server listens on (Render sets this automatically to 10000)
PORT=10000

# The public URL of your bot deployment.
# Note: On Render, RENDER_EXTERNAL_URL is auto-populated, so no manual configuration is needed!
# If deploying elsewhere, set PING_URL to your public app URL to enable self-pinging.
# RENDER_EXTERNAL_URL=https://your-bot-name.onrender.com
# PING_URL=https://your-bot-name.onrender.com

# --- Free-Tier Persistent Telegram Backup Settings ---
# The numerical Chat or Channel ID used for persistent DB backups (e.g. -100123456789)
# Create a private Telegram channel, add the bot as an Admin with post & pin permissions,
# and enter the Channel's ID below to enable 100% free persistence on Render!
BACKUP_CHAT_ID=-100123456789


